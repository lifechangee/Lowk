{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lowk",
  "identifier": "dev.lowk.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/lowk-app/lowk/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/nsis/hooks.nsh",
        "customLanguageFiles": {
          "English": "windows/nsis/English.nsh",
          "Russian": "windows/nsis/Russian.nsh"
        }
      }
    }
  }
}
