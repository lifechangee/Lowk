{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: every app command except overlay_*. No core:window permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-app-quit",
    "allow-binds-get",
    "allow-binds-record-start",
    "allow-binds-record-stop",
    "allow-binds-set",
    "allow-call-delete",
    "allow-call-get",
    "allow-call-get-md",
    "allow-call-list",
    "allow-call-move",
    "allow-call-rename",
    "allow-call-restore",
    "allow-call-save-md",
    "allow-call-set-tags",
    "allow-call-summarized",
    "allow-capture-screenshot",
    "allow-demo-start",
    "allow-engine-install",
    "allow-engine-list",
    "allow-export-vault",
    "allow-folder-create",
    "allow-folder-delete",
    "allow-folder-get",
    "allow-folder-list",
    "allow-folder-update",
    "allow-hw-bench",
    "allow-hw-probe",
    "allow-import-vault",
    "allow-llm-ask",
    "allow-llm-cancel",
    "allow-llm-set-template",
    "allow-locale-get",
    "allow-main-open",
    "allow-perm-open-settings",
    "allow-perm-request",
    "allow-perm-status",
    "allow-queue-clear",
    "allow-secret-delete",
    "allow-secret-set",
    "allow-secret-status",
    "allow-session-pause",
    "allow-session-resume",
    "allow-session-snapshot",
    "allow-session-start",
    "allow-session-state",
    "allow-session-stop",
    "allow-settings-get",
    "allow-settings-patch",
    "allow-source-list",
    "allow-source-list-installed",
    "allow-stealth-selftest",
    "allow-stealth-status",
    "allow-trash-empty",
    "allow-update-check",
    "allow-vault-info",
    "allow-vault-open"
  ]
}