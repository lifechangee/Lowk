{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stealth-spike",
  "version": "0.0.1",
  "identifier": "dev.lowk.stealthspike",
  "build": { "frontendDist": "../ui" },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Lowk Spike MAIN", "url": "main.html",
        "width": 500, "height": 400, "x": 700, "y": 150 },
      { "label": "overlay", "url": "overlay.html", "title": "overlay",
        "width": 360, "height": 160, "x": 100, "y": 150,
        "decorations": false, "transparent": true, "alwaysOnTop": true,
        "skipTaskbar": true, "shadow": false, "resizable": false, "focus": false,
        "visibleOnAllWorkspaces": true, "contentProtected": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
